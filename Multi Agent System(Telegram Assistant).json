    {
      "parameters": {
        "toolDescription": "This handles all things email",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "=You are a helpful email assistant who does all things email -\n\n1. If user asks for sending an email, use the send message tool\n2. If user asks for drafting an email, use the draft message tool\n3. If user either asks for read/summary/get some number of emails, use get many messages tool\n4. If user either asks for reply to a thread or delete an email -\n  a. First fetch the email via get message tool, extract the message ID of that email\n  b. Use that message ID dynamically in the respective reply/delete tools as per the user instructions\n\n\n5. Every time, send the response using the Send a text message in Telegram. Whether what should be the execution, respond accordingly with the help of the Send a text message in Telegram every time whenever you execute any task with any of the steps. \n\nFor every progess or action you make, update the user back via telegram tool"
        }
      },
